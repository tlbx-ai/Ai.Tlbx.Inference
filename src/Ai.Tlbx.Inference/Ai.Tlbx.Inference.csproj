<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Ai.Tlbx.Inference</RootNamespace>
    <PackageId>Ai.Tlbx.Inference</PackageId>
    <Description>Trim-friendly .NET AI inference client for OpenAI, Anthropic, Google, and xAI with streaming, document attachments, structured output, tool calling, embeddings, and image generation.</Description>
    <PackageProjectUrl>https://github.com/tlbx-ai/Ai.Tlbx.Inference</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tlbx-ai/Ai.Tlbx.Inference</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ai;inference;openai;anthropic;google;gemini;xai;grok;llm;embeddings;tool-calling;streaming;attachments;aot;trimming</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Add beta OpenAI hosted-agent sessions, streaming, saved items, cancellation and service-side MCP through the inference facade. Dual-target .NET 10 and .NET 11. The separate web playground is not included in this package.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ai.Tlbx.Inference.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.*" />
    <PackageReference Include="Polly.Core" Version="8.*" />
  </ItemGroup>
</Project>
